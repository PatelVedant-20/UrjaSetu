# ---------------------------------------------------------------------------
# UrjaSetu — Phase 0 environment template
#
# Copy to `.env` and adjust. NEVER commit a real `.env` file.
# No credentials are hard-coded anywhere in application code.
# ---------------------------------------------------------------------------

# Application
APP_ENV=development
APP_NAME=UrjaSetu
API_V1_PREFIX=/api/v1
LOG_LEVEL=INFO

# PostgreSQL container (docker-compose.yml reads these)
POSTGRES_DB=urjasetu
POSTGRES_USER=urjasetu
POSTGRES_PASSWORD=urjasetu
POSTGRES_PORT=5432

# Application database connection.
# In Phase 0 only PostgreSQL runs in Docker; the backend runs on the host,
# so the host is `localhost` and the port is POSTGRES_PORT above.
DATABASE_URL=postgresql+psycopg://urjasetu:urjasetu@localhost:5432/urjasetu

# If/when the backend itself is containerized on the compose network,
# use the service hostname instead:
# DATABASE_URL=postgresql+psycopg://urjasetu:urjasetu@db:5432/urjasetu

# Maintenance database used ONLY by the automated migration smoke test.
# It connects here to create/drop a throwaway database and prove that
# `alembic upgrade head` works from a genuinely empty schema.
MAINTENANCE_DATABASE_URL=postgresql+psycopg://urjasetu:urjasetu@localhost:5432/postgres

# Connection pool
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_PRE_PING=true
DB_ECHO=false
